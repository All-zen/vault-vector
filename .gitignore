# --- o que NUNCA pode subir ---------------------------------------------
# Comentario fica na linha de cima: o git nao aceita comentario no fim da
# linha, e "config.toml   # ..." vira um padrao que nao casa com nada.

# tem o caminho do seu vault
config.toml
# o indice: o texto integral das suas notas
*.db
*.db-wal
*.db-shm
# token do modo HTTP
.token
servico.log
servico.log.anterior
# o modelo de teste cita titulos das suas notas
perguntas*.txt

# --- ruido -------------------------------------------------------------
.venv/
__pycache__/
*.egg-info/
build/
dist/

# --- interface ------------------------------------------------------------
# A interface compilada vai para dentro do pacote, mas e gerada: o CI e o
# setup.ps1 compilam a partir de ui/.
vault_rag/static/
ui/node_modules/
